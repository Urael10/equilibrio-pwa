{
  "name": "equilibrio-pwa",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "description": "Equilibrio: PWA de aprendizaje y gamificación en Fitness & Wellness (mascota virtual + puzle de planificación diaria).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "validar": "vitest run tests/content.test.ts",
    "build:prototipo": "vite build --mode prototipo",
    "icons": "python3 scripts/make-icons.py"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "dexie": "^4.4.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.8",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
